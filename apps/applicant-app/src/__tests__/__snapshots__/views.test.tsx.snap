exports[`Views Snapshots > NurseryDetailView > should match snapshot for desktop > desktop 1`] = `
<DocumentFragment>
  <div
    class="application-view"
  >
    <button
      class="btn-back"
    >
      ← Back to Nurseries
    </button>
    <h2
      style="margin: 0px 0px 10px;"
    >
      Sunnyside Daycare
    </h2>
    <p
      style="color: rgb(102, 102, 102); margin-bottom: 20px;"
    >
      Details for nursery 1
    </p>
    <div
      class="nursery-positions"
    >
      <h3
        style="font-size: 1.2rem; margin-bottom: 15px;"
      >
        Open Positions
      </h3>
      <div
        class="positions-grid"
        style="grid-template-columns: 1fr; margin-top: 10px;"
      >
        <div
          class="position-card"
        >
          <h3
            style="margin: 0px 0px 10px;"
          >
            Lead Educator
          </h3>
          <div
            style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; gap: 10px;"
          >
            <div
              style="display: flex; gap: 5px; flex-wrap: wrap;"
            >
              <span
                class="badge open"
              >
                open
              </span>
            </div>
            <button
              class="btn-primary"
            >
              Apply
            </button>
          </div>
        </div>
        <div
          class="position-card"
        >
          <h3
            style="margin: 0px 0px 10px;"
          >
            Assistant Teacher
          </h3>
          <div
            style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; gap: 10px;"
          >
            <div
              style="display: flex; gap: 5px; flex-wrap: wrap;"
            >
              <span
                class="badge open"
              >
                open
              </span>
            </div>
            <button
              class="btn-primary"
            >
              Apply
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

