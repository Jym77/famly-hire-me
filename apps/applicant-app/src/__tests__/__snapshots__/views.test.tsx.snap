exports[`Views Snapshots > NurseriesView > should match snapshot for desktop > desktop 1`] = `
<DocumentFragment>
  <div>
    <div
      class="view-filters"
    >
      <div
        class="filter-group"
      >
        <label
          for="nursery-search"
        >
          Search
        </label>
        <input
          id="nursery-search"
          placeholder="Search nurseries or roles..."
          type="text"
          value=""
        />
      </div>
      <div
        class="filter-group"
      >
        <label>
          Vacancy
        </label>
        <div
          class="radio-group"
        >
          <label>
            <input
              checked=""
              name="vacancy"
              type="radio"
              value="all"
            />
             All
          </label>
          <label>
            <input
              name="vacancy"
              type="radio"
              value="has"
            />
             Has Openings
          </label>
          <label>
            <input
              name="vacancy"
              type="radio"
              value="none"
            />
             No Openings
          </label>
        </div>
      </div>
    </div>
    <div
      class="positions-grid"
    >
      <div
        class="position-card"
      >
        <h3>
          Sunnyside Daycare
        </h3>
        <p>
          ID: 1
        </p>
        <div
          style="display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 15px;"
        >
          <span
            class="badge open"
          >
            Has Openings
          </span>
        </div>
      </div>
      <div
        class="position-card"
      >
        <h3>
          Green Garden Preschool
        </h3>
        <p>
          ID: 2
        </p>
        <div
          style="display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 15px;"
        >
          <span
            class="badge open"
          >
            Has Openings
          </span>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

