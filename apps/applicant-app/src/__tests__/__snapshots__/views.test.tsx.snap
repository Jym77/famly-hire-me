// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Views Snapshots > ApplicationView > should match snapshot for desktop > desktop 1`] = `
<DocumentFragment>
  <div
    class="application-view"
  >
    <button
      class="btn-back"
    >
      ← Back
    </button>
    <h2
      style="margin: 0px 0px 10px;"
    >
      Apply for Lead Educator
    </h2>
    <form
      class="apply-form"
    >
      <div
        class="form-group"
      >
        <label
          for="applicantData"
        >
          Your Contact Info (Name, Email, Phone)
        </label>
        <textarea
          id="applicantData"
          name="applicantData"
          placeholder="e.g. Jane Doe, jane@example.com, 555-0123"
          required=""
        />
      </div>
      <button
        class="btn-submit"
        type="submit"
      >
        Submit Application
      </button>
    </form>
  </div>
</DocumentFragment>
`;

